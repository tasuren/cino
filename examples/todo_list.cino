/// TODO List — Action generation sample
///
/// State   : Int (pending task count)
/// Event   : AddTask / CompleteTask / Clear
/// Query   : PendingCount
/// Action  : TaskCompleted (side-effect request to notify the host when a task is completed)
///
/// Points: Domain code does not execute side effects directly,
///           but returns Actions to delegate execution to the host.

enum Action =
  | TaskCompleted

enum Result<T, E> =
  | Ok  { v: T }
  | Err { e: E }

event TodoEvent =
  | AddTask
  | CompleteTask
  | Clear

query TodoQuery =
  | PendingCount

update(pending: Int, event: TodoEvent) -> (Int, List<Action>) {
  match event {
    AddTask      => (pending + 1, [])
    CompleteTask => (pending - 1, [TaskCompleted {}])
    Clear        => (0, [])
  }
}

query(pending: Int, q: TodoQuery) -> Result<Int, Int> {
  match q {
    PendingCount => Ok { v: pending }
  }
}
