/// Shopping Cart — Larger sample
///
/// State   : Int (cart total amount)
/// Event   : AddItem / RemoveItem / ApplyDiscount / PlaceOrder / Clear
/// Query   : GetTotal
/// Action  : OrderPlaced { total } / CartCleared
///
/// Key Points:
///   - Encapsulate discount calculation in a user-defined function (fn)
///   - Request "Order Placed" action to the host via PlaceOrder
///   - Request "Cart Cleared" action to the host via Clear
///   - Domain code only handles amount addition/subtraction and Action generation

enum Action =
  | OrderPlaced { total: Int }
  | CartCleared

enum Result<T, E> =
  | Ok  { v: T }
  | Err { e: E }

event CartEvent =
  | AddItem       { price: Int }
  | RemoveItem    { price: Int }
  | ApplyDiscount { amount: Int }
  | PlaceOrder
  | Clear

query CartQuery =
  | GetTotal

fn apply_discount(total: Int, discount: Int) -> Int {
  total - discount
}

update(total: Int, event: CartEvent) -> (Int, List<Action>) {
  match event {
    AddItem       { price }  => (total + price, [])
    RemoveItem    { price }  => (total - price, [])
    ApplyDiscount { amount } => (apply_discount(total, amount), [])
    PlaceOrder               => (0, [OrderPlaced { total: total }])
    Clear                    => (0, [CartCleared {}])
  }
}

query(total: Int, q: CartQuery) -> Result<Int, Int> {
  match q {
    GetTotal => Ok { v: total }
  }
}
