/// Traffic Light — Enum state machine sample
///
/// State   : TrafficLight (example of using an enum directly as state)
/// Event   : Tick (advance by one stage)
/// Query   : CurrentLight
/// Action  : None
///
/// Transitions: Red -> Green -> Yellow -> Red -> ...

enum Action =
  | NoOp

enum Result<T, E> =
  | Ok  { v: T }
  | Err { e: E }

enum TrafficLight =
  | Red
  | Yellow
  | Green

event TrafficEvent =
  | Tick

query TrafficQuery =
  | CurrentLight

update(light: TrafficLight, event: TrafficEvent) -> (TrafficLight, List<Action>) {
  match event {
    Tick => (match light {
      Red    => Green {}
      Green  => Yellow {}
      Yellow => Red {}
    }, [])
  }
}

query(light: TrafficLight, q: TrafficQuery) -> Result<TrafficLight, Int> {
  match q {
    CurrentLight => Ok { v: light }
  }
}
